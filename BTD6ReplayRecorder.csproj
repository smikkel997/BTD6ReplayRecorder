<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\BloonsTD6</GameDir>
    <AssemblyTitle>BTD6ReplayRecorder</AssemblyTitle>
    <Description>Native deterministic gameplay recorder and spectator viewer for Bloons TD 6</Description>
    <Authors>Smikkel997</Authors>
    <Company>Smikkel997</Company>
    <Version>1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Smikkel997/BTD6ReplayRecorder</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- MelonLoader Net6 -->
    <Reference Include="$(GameDir)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />

    <!-- Il2Cpp Assemblies -->
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppSystem.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppSystem.Core.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppNinjaKiwi.Common.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppNewtonsoft.Json.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppNinjaKiwi.Analytics.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppNinjaKiwi.GUTS.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.UnityWebRequestModule.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppNinjaKiwi.LiNK.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppNinjaKiwi.LiNK.Client.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppNinjaKiwi.Localization.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\Unity.ResourceManager.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\Unity.Addressables.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.ImageConversionModule.dll" Private="false" />

    <!-- BTD6 Mod Helper -->
    <Reference Include="$(GameDir)\Mods\Btd6ModHelper.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*" />
  </ItemGroup>

  <!-- Auto deploy on build -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" ContinueOnError="true" Retries="1" RetryDelayMilliseconds="100" />
  </Target>

</Project>
